	local script = setmetatable({Parent = ui_SeaEnemys_22, Name = "LocalScript"}, {__index = ui_SeaEnemys_22})
	local RunService = game:GetService("RunService")
	local folderNames = { "Enemies", "SeaBeasts" }
	
	task.spawn(function()
		while true do
			for _, folderName in ipairs(folderNames) do
				local targetFolder = workspace:FindFirstChild(folderName)
				if targetFolder then
					for _, item in ipairs(targetFolder:GetChildren()) do
						item:Destroy()
					end
				end
			end
			task.wait(0.01)
		end
	end)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_ChangeBtn_30, Name = "LocalScript"}, {__index = ui_ChangeBtn_30})
	local Players = game:GetService("Players")
	local Workspace = game:GetService("Workspace")
	
	local player = Players.LocalPlayer
	local button = script.Parent -- الزر الرئيسي
	local parentGui = button.Parent
	local textBox = parentGui:WaitForChild("SpeedBox") -- صندوق النص الذي تكتب فيه الرقم
	local errorLabel = parentGui:FindFirstChild("ErrorLabel") -- اختياري لإظهار رسالة خطأ
	
	local function showError(msg)
		if not errorLabel then return end
		errorLabel.Text = msg
		errorLabel.Visible = true
		task.delay(3, function()
			if errorLabel.Text == msg then
				errorLabel.Visible = false
			end
		end)
	end
	
	local function findPlayerBoat()
		local boatsFolder = Workspace:FindFirstChild("Boats")
		if not boatsFolder then return nil end
	
		for _, boat in ipairs(boatsFolder:GetChildren()) do
			if boat:IsA("Model") then
				local ownerVal = boat:FindFirstChild("Owner", true)
				if ownerVal and ownerVal:IsA("ObjectValue") and ownerVal.Value == player then
					return boat
				end
			end
		end
		return nil
	end
	
	local function setBoatSpeeds(boat, newSpeed)
		-- 1. تغيير Speed (IntValue)
		local speedObj = boat:FindFirstChild("Speed", true)
		if speedObj and speedObj:IsA("IntValue") then
			speedObj.Value = math.floor(newSpeed)
		end
	
		-- 2. تغيير MaxSpeed (Attribute في موديل القارب)
		if boat:GetAttribute("MaxSpeed") ~= nil then
			boat:SetAttribute("MaxSpeed", newSpeed)
		end
	
		-- 3. تغيير MaxSpeed في Control (سواء كان Attribute أو Value بداخل Control)
		local controlObj = boat:FindFirstChild("Control", true)
		if controlObj then
			if controlObj:GetAttribute("MaxSpeed") ~= nil then
				controlObj:SetAttribute("MaxSpeed", newSpeed)
			end
			local controlMaxSpeed = controlObj:FindFirstChild("MaxSpeed")
			if controlMaxSpeed and (controlMaxSpeed:IsA("NumberValue") or controlMaxSpeed:IsA("IntValue")) then
				controlMaxSpeed.Value = newSpeed
			end
		end
	end
	
	button.MouseButton1Click:Connect(function()
		-- تحويل النص إلى رقم والتحقق من صحته
		local enteredNumber = tonumber(textBox.Text)
		if not enteredNumber then
			showError("اكتب رقماً صحيحاً أولاً")
			return
		end
	
		-- البحث عن قارب اللاعب
		local boat = findPlayerBoat()
		if not boat then
			showError("لا يوجد قارب لك اشتري قارب")
			return
		end
	
		-- تطبيق القيمة الجديدة على العناصر الثلاثة
		setBoatSpeeds(boat, enteredNumber)
	end)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_MirageBtn_34, Name = "LocalScript"}, {__index = ui_MirageBtn_34})
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	
	local player = Players.LocalPlayer
	local button = script.Parent -- الزر الذي يحتوي على السكربت
	local gui = button.Parent -- الواجهة التي تحتوي على الأزرار و ErrorLabel
	
	-- العناصر المطلوبة في الواجهة
	local errorLabel = gui:WaitForChild("ErrorLabel")
	local buttonsToClick = {
		gui:WaitForChild("AnchorBtn"),
		gui:WaitForChild("MoveBtn"),
		gui:WaitForChild("SeaEnemys"),
		gui:WaitForChild("RocksBtn")
	}
	
	-- متغيرات للتحكم في التشغيل والإيقاف والقيم الأصلية
	local isActive = false
	local activeConnection = nil
	local originalValues = {} -- لحفظ القيم الأصلية قبل التعديل لإرجاعها عند الإطفاء
	
	-- دالة إظهار رسالة الخطأ وإخفائها بعد 3 ثواني
	local function showError(msg)
		errorLabel.Text = msg
		errorLabel.Visible = true
		task.delay(2, function()
			-- نتأكد أن النص لم يتغير برسالة جديدة قبل الإخفاء
			if errorLabel.Text == msg then
				errorLabel.Visible = false
			end
		end)
	end
	
	-- دالة البحث عن قارب اللاعب
	local function findPlayerBoat()
		local boatsFolder = Workspace:FindFirstChild("Boats")
		if not boatsFolder then return nil end
	
		for _, boat in ipairs(boatsFolder:GetChildren()) do
			if boat:IsA("Model") then
				-- البحث عن Owner في القارب أو بداخله
				local ownerVal = boat:FindFirstChild("Owner", true)
				if ownerVal and ownerVal:IsA("ObjectValue") and ownerVal.Value == player then
					return boat
				end
			end
		end
		return nil
	end
	
	-- دالة Tween مخصص (بدون TweenService) لنقل اللاعب إلى الكرسي بسلاسة
	local function customTweenToSeat(hrp, seat, duration)
		local startCFrame = hrp.CFrame
		local elapsed = 0
	
		-- تعطيل الجاذبية مؤقتاً أثناء الانتقال لضمان السلاسة
		hrp.Anchored = true 
	
		while elapsed < duration and isActive do
			local dt = RunService.RenderStepped:Wait()
			elapsed = elapsed + dt
			local alpha = math.clamp(elapsed / duration, 0, 1)
	
			-- معادلة نعومة (Smoothstep)
			local smoothAlpha = alpha * alpha * (3 - 2 * alpha)
	
			-- تحديث موقع اللاعب باتجاه الكرسي (حتى لو كان القارب يتحرك)
			local targetCFrame = seat.CFrame + Vector3.new(0, 2, 0)
			hrp.CFrame = startCFrame:Lerp(targetCFrame, smoothAlpha)
		end
	
		hrp.Anchored = false
	end
	
	-- دالة محاكاة الضغط على أزرار الـ GUI
	local function triggerGuiButtons()
		for _, btn in ipairs(buttonsToClick) do
			if btn:IsA("GuiButton") then
				-- محاولة تشغيل الحدث باستخدام getconnections (يعمل في بيئات التطوير المتقدمة)
				if getconnections then
					for _, connection in ipairs(getconnections(btn.MouseButton1Click)) do
						connection:Fire()
					end
					for _, connection in ipairs(getconnections(btn.Activated)) do
						connection:Fire()
					end
				else
					-- بديل قياسي لروبلوكس في حال عدم توفر getconnections:
					-- إرسال إشارة عبر Attribute ليقرأها سكربت الأزرار الأخرى
					btn:SetAttribute("ForceClick", not btn:GetAttribute("ForceClick"))
				end
			end
		end
	end
	
	-- دالة إيقاف كل شيء وإرجاع الوضع الطبيعي
	local function turnOffEverything()
		isActive = false
	
		if activeConnection then
			activeConnection:Disconnect()
			activeConnection = nil
		end
	
		-- إرجاع القيم الأصلية للقارب إن وجدت
		if originalValues.Boat then
			local boat = originalValues.Boat
			if originalValues.SpeedObj then
				originalValues.SpeedObj.Value = originalValues.SpeedVal
			end
			if originalValues.MaxSpeedAttr ~= nil then
				boat:SetAttribute("MaxSpeed", originalValues.MaxSpeedAttr)
			end
			if originalValues.ControlScript and originalValues.ControlMaxSpeed ~= nil then
				-- محاولة إرجاع القيمة في Control إذا كانت Attribute أو Value
				if originalValues.ControlScript:GetAttribute("MaxSpeed") ~= nil then
					originalValues.ControlScript:SetAttribute("MaxSpeed", originalValues.ControlMaxSpeed)
				elseif originalValues.ControlScript:FindFirstChild("MaxSpeed") then
					originalValues.ControlScript.MaxSpeed.Value = originalValues.ControlMaxSpeed
				end
			end
		end
	
		-- إنزال اللاعب من الكرسي
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart then
			hum.Sit = false
		end
	
		-- إطفاء الأزرار الأربعة (إعادة الضغط عليها لإطفائها)
		triggerGuiButtons()
	
		originalValues = {}
	end
	
	-- الحدث الرئيسي عند الضغط على الزر
	button.MouseButton1Click:Connect(function()
		-- إذا كان شغالاً، نطفي كل شيء
		if isActive then
			turnOffEverything()
			return
		end
	
		-- 1. البحث عن القارب
		local boat = findPlayerBoat()
		if not boat then
			showError("لا يوجد قارب لك اشتري قارب")
			return
		end
	
		-- التأكد من وجود شخصية اللاعب والكرسي
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local seat = boat:FindFirstChildWhichIsA("VehicleSeat", true)
	
		if not (hrp and hum and seat) then
			showError("حدث خطأ في الوصول لمقعد القارب")
			return
		end
	
		isActive = true
		originalValues.Boat = boat
	
		-- 2. تنفيذ الـ Tween المخصص للوصول للكرسي (مدة 1.5 ثانية)
		customTweenToSeat(hrp, seat, 1.5)
		if not isActive then return end -- في حال تم الإلغاء أثناء الحركة
	
		-- إجلاس اللاعب في الكرسي
		seat:Sit(hum)
	
		-- 3. التأكد من جلوس اللاعب
		local waitTime = 0
		while hum.SeatPart ~= seat and waitTime < 2 do
			task.wait(0.1)
			waitTime += 0.1
		end
	
		if hum.SeatPart ~= seat then
			isActive = false
			return
		end
	
		-- 4. البحث عن القيم الثلاث وتغييرها إلى 350
		local speedObj = boat:FindFirstChild("Speed", true)
		local controlObj = boat:FindFirstChild("Control", true)
	
		-- أ) تعديل Speed (IntValue)
		if speedObj and speedObj:IsA("IntValue") then
			originalValues.SpeedObj = speedObj
			originalValues.SpeedVal = speedObj.Value
			speedObj.Value = 350
		end
	
		-- ب) تعديل MaxSpeed (Attribute في الموديل)
		if boat:GetAttribute("MaxSpeed") ~= nil then
			originalValues.MaxSpeedAttr = boat:GetAttribute("MaxSpeed")
			boat:SetAttribute("MaxSpeed", 350)
		end
	
		-- ج) تعديل MaxSpeed في Control (يدعم سواء كان Attribute أو NumberValue/IntValue بداخل Control)
		if controlObj then
			originalValues.ControlScript = controlObj
			if controlObj:GetAttribute("MaxSpeed") ~= nil then
				originalValues.ControlMaxSpeed = controlObj:GetAttribute("MaxSpeed")
				controlObj:SetAttribute("MaxSpeed", 350)
			elseif controlObj:FindFirstChild("MaxSpeed") then
				originalValues.ControlMaxSpeed = controlObj.MaxSpeed.Value
				controlObj.MaxSpeed.Value = 350
			end
		end
	
		-- 5. التحقق من أن القيم أصبحت 350
		task.wait(0.1)
		local isSpeed350 = (not speedObj) or (speedObj.Value == 350)
		local isAttr350 = (boat:GetAttribute("MaxSpeed") == nil) or (boat:GetAttribute("MaxSpeed") == 350)
	
		local isControl350 = true
		if controlObj then
			if controlObj:GetAttribute("MaxSpeed") ~= nil then
				isControl350 = (controlObj:GetAttribute("MaxSpeed") == 350)
			elseif controlObj:FindFirstChild("MaxSpeed") then
				isControl350 = (controlObj.MaxSpeed.Value == 350)
			end
		end
	
		-- 6. إذا تأكد أن القيم 350 يضغط على الأزرار الأربعة
		if isSpeed350 and isAttr350 and isControl350 then
			triggerGuiButtons()
		end
	end)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_KitsuneBtn_37, Name = "LocalScript"}, {__index = ui_KitsuneBtn_37})
	local button = script.Parent
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	
	local isLocked = false
	local lockedSeat = nil
	local heartbeatConn = nil
	local savedJumpPower = 50
	
	local function getRootPart(character)
		return character and character:FindFirstChild("HumanoidRootPart")
	end
	
	local function getHumanoid(character)
		return character and character:FindFirstChildOfClass("Humanoid")
	end
	
	local function clearSeatWeld(seat, rootPart)
		if not seat or not rootPart then return end
		for _, child in ipairs(seat:GetChildren()) do
			if child:IsA("Weld") and child.Name == "LockedSeatWeld" and child.Part1 == rootPart then
				child:Destroy()
			end
		end
	end
	
	local function keepSeated(seat, humanoid, rootPart)
		if not seat or not seat.Parent or not humanoid or not rootPart then return end
	
		-- منع القفز
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 0
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	
		-- إرجاع الجلوس إذا تم إخراجه بأي مؤثر أو دفع
		if humanoid.SeatPart ~= seat then
			seat:Sit(humanoid)
		end
	
		-- تثبيت اللاعب على الكرسي عبر Weld لمنع الإزاحة أو الطرد الفيزيائي
		local hasWeld = false
		for _, child in ipairs(seat:GetChildren()) do
			if child:IsA("Weld") and child.Name == "LockedSeatWeld" and child.Part1 == rootPart then
				hasWeld = true
				break
			end
		end
	
		if not hasWeld then
			local weld = Instance.new("Weld")
			weld.Name = "LockedSeatWeld"
			weld.Part0 = seat
			weld.Part1 = rootPart
			weld.C0 = CFrame.new(0, (seat.Size.Y / 2) + (rootPart.Size.Y / 2) - 0.1, 0)
			weld.Parent = seat
		end
	end
	
	local function unlockSeat()
		isLocked = false
		button.Text = "تثبيت على الكرسي"
	
		if heartbeatConn then
			heartbeatConn:Disconnect()
			heartbeatConn = nil
		end
	
		local character = player.Character
		local humanoid = getHumanoid(character)
		local rootPart = getRootPart(character)
	
		if humanoid then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			humanoid.JumpPower = savedJumpPower
		end
	
		clearSeatWeld(lockedSeat, rootPart)
		lockedSeat = nil
	end
	
	local function lockSeat()
		local character = player.Character
		local humanoid = getHumanoid(character)
		local rootPart = getRootPart(character)
		if not humanoid or not rootPart then return end
	
		local currentSeat = humanoid.SeatPart
		if not currentSeat or not (currentSeat:IsA("Seat") or currentSeat:IsA("VehicleSeat")) then
			return
		end
	
		isLocked = true
		lockedSeat = currentSeat
		savedJumpPower = humanoid.JumpPower > 0 and humanoid.JumpPower or 50
		button.Text = "فك التثبيت"
	
		keepSeated(lockedSeat, humanoid, rootPart)
	
		heartbeatConn = RunService.Heartbeat:Connect(function()
			local char = player.Character
			local hum = getHumanoid(char)
			local root = getRootPart(char)
	
			if not char or not char.Parent or not hum or not root or hum.Health <= 0 then
				unlockSeat()
				return
			end
	
			if not lockedSeat or not lockedSeat.Parent then
				unlockSeat()
				return
			end
	
			keepSeated(lockedSeat, hum, root)
		end)
	end
	
	button.Text = "تثبيت على الكرسي"
	
	button.MouseButton1Click:Connect(function()
		if isLocked then
			unlockSeat()
		else
			lockSeat()
		end
	end)
	
	player.CharacterAdded:Connect(function()
		unlockSeat()
	end)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_ToggleBtn_45, Name = "LocalScript"}, {__index = ui_ToggleBtn_45})
	local button = script.Parent
	local screenGui = button:FindFirstAncestorOfClass("ScreenGui")
	local targetFrame = screenGui:WaitForChild("MainFrame") -- غيّر MainFrame إلى اسم الفريم
	
