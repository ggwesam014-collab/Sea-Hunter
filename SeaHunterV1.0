task.spawn(function()
	local script = setmetatable({Parent = ui_SkyStuts_14, Name = "LocalScript"}, {__index = ui_SkyStuts_14})
	local Lighting = game:GetService("Lighting")
	local RunService = game:GetService("RunService")
	local label = script.Parent
	
	local function updateSkyStatus()
		local clockTime = Lighting.ClockTime
		local isNight = (clockTime >= 18) or (clockTime < 6)
		local status = isNight and "ليل🌙" or "صباح☀"
		label.Text = "حالة السماء: " .. status
	end
	
	updateSkyStatus()
	RunService.RenderStepped:Connect(updateSkyStatus)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_MoonStuts_15, Name = "LocalScript"}, {__index = ui_MoonStuts_15})
	local Lighting = game:GetService("Lighting")
	local label = script.Parent
	
	if not label:IsA("TextLabel") then
		warn("يجب وضع السكربت داخل TextLabel")
		return
	end
	
	local TOTAL_PHASES = 8
	local FULL_MOON_PHASE = 5 -- البدر يقع في الطور رقم 5
	
	-- ترتيب الأطوار من 1 إلى 8 وعدد الليالي المتبقية للوصول إلى الطور 5 (Full Moon)
	local MoonPhases = {
		["9709150401"] = { Index = 1, Name = "", NightsToFull = 4 },
		["9709150086"] = { Index = 2, Name = "", NightsToFull = 3 },
		["9709149680"] = { Index = 3, Name = "", NightsToFull = 2 },
		["9709149052"] = { Index = 4, Name = "", NightsToFull = 1 },
		["9709149431"] = { Index = 5, Name = "Full Moon", NightsToFull = 0 },
		["9709143733"] = { Index = 6, Name = "", NightsToFull = 7 },
		["9709139597"] = { Index = 7, Name = "", NightsToFull = 6 },
		["9709135895"] = { Index = 8, Name = "", NightsToFull = 5 },
	}
	
	local function getAssetId(textureStr)
		if type(textureStr) ~= "string" then
			return nil
		end
		return string.match(textureStr, "%d+")
	end
	
	local function isNight(clockTime)
		-- الليل يبدأ من 18:00 وحتى 06:00
		return clockTime >= 18 or clockTime < 6
	end
	
	local function getWhenFullMoonText(phaseInfo, clockTime)
		local nightNow = isNight(clockTime)
	
		-- الحالة 1: الطور 5 والوقت ليل (Full Moon شغال الآن)
		if phaseInfo.Index == FULL_MOON_PHASE and nightNow then
			return "الفل مون: الآن (نشط)"
		end
	
		-- الحالة 2: الطور 5 لكن الوقت نهار (سيظهر الليلة عند الساعة 18:00)
		if phaseInfo.Index == FULL_MOON_PHASE and not nightNow then
			local hoursLeftInGame = 18 - clockTime
			local realMinutesLeft = math.max(0, hoursLeftInGame) -- 1 دقيقة حقيقية ≈ 1 ساعة داخل اللعبة
			return string.format("الفل مون: الليلة (بعد ~%.1f د)", realMinutesLeft)
		end
	
		-- الحالة 3: أي طور آخر -> نحسب عدد الليالي المتبقية للوصول للطور 5
		-- ملاحظة: كل ليلة في اللعبة تعادل 24 دقيقة واقعية تقريباً
		local nightsLeft = phaseInfo.NightsToFull
		local approxMinutes = nightsLeft * 24
	
		if nightsLeft == 1 then
			return string.format("الفل مون: الليلة القادمة (~%d د)", approxMinutes)
		else
			return string.format("الفل مون: بعد %d ليالٍ (~%d د)", nightsLeft, approxMinutes)
		end
	end
	
	local function updateUI()
		local sky = Lighting:FindFirstChildOfClass("Sky")
		if not sky then
			label.Text = "? / 8 | الفل مون: غير معروف"
			return
		end
	
		local assetId = getAssetId(sky.MoonTextureId)
		local phaseInfo = assetId and MoonPhases[assetId]
	
		if not phaseInfo then
			label.Text = "? / 8 | الفل مون: طور غير مسجل"
			return
		end
	
		local statusText = getWhenFullMoonText(phaseInfo, Lighting.ClockTime)
		label.Text = string.format("%d / %d | %s", phaseInfo.Index, TOTAL_PHASES, statusText)
	end
	
	-- تحديث فوري عند تغير الوقت أو صورة القمر أو إضافة Sky
	Lighting:GetPropertyChangedSignal("ClockTime"):Connect(updateUI)
	
	Lighting.ChildAdded:Connect(function(child)
		if child:IsA("Sky") then
			updateUI()
			child:GetPropertyChangedSignal("MoonTextureId"):Connect(updateUI)
		end
	end)
	
	local existingSky = Lighting:FindFirstChildOfClass("Sky")
	if existingSky then
		existingSky:GetPropertyChangedSignal("MoonTextureId"):Connect(updateUI)
	end
	
	updateUI()
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_Clock_16, Name = "LocalScript"}, {__index = ui_Clock_16})
	local Lighting = game:GetService("Lighting")
	local label = script.Parent
	
	if not label:IsA("TextLabel") then
		warn("يجب وضع السكربت داخل TextLabel")
		return
	end
	
	local function isNight(clockTime)
		return clockTime >= 18 or clockTime < 6
	end
	
	local function formatClockTimeHMS(clockTime)
		local normalized = clockTime % 24
		local totalSeconds = math.floor(normalized * 3600)
	
		local hours = math.floor(totalSeconds / 3600) % 24
		local minutes = math.floor((totalSeconds % 3600) / 60)
		local seconds = totalSeconds % 60
	
		return string.format("%02d:%02d:%02d", hours, minutes, seconds)
	end
	
	local function updateClockLabel()
		local clockTime = Lighting.ClockTime
		local formatted = formatClockTimeHMS(clockTime)
		local period = isNight(clockTime) and "ليل" or "نهار"
	
		label.Text = string.format("الساعة: %s (%s)", formatted, period)
	end
	
	Lighting:GetPropertyChangedSignal("ClockTime"):Connect(updateClockLabel)
	updateClockLabel()
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_AnchorBtn_17, Name = "LocalScript"}, {__index = ui_AnchorBtn_17})
	local button = script.Parent
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	
	local isLocked = false
	local lockedSeat = nil
	local heartbeatConn = nil
	local savedJumpPower = 50
	
	local function getRootPart(character)
		return character and character:FindFirstChild("HumanoidRootPart")
	end
	
	local function getHumanoid(character)
		return character and character:FindFirstChildOfClass("Humanoid")
	end
	
	local function clearSeatWeld(seat, rootPart)
		if not seat or not rootPart then return end
		for _, child in ipairs(seat:GetChildren()) do
			if child:IsA("Weld") and child.Name == "LockedSeatWeld" and child.Part1 == rootPart then
				child:Destroy()
			end
		end
	end
	
	local function keepSeated(seat, humanoid, rootPart)
		if not seat or not seat.Parent or not humanoid or not rootPart then return end
	
		-- منع القفز
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 0
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	
		-- إرجاع الجلوس إذا تم إخراجه بأي مؤثر أو دفع
		if humanoid.SeatPart ~= seat then
			seat:Sit(humanoid)
		end
	
		-- تثبيت اللاعب على الكرسي عبر Weld لمنع الإزاحة أو الطرد الفيزيائي
		local hasWeld = false
		for _, child in ipairs(seat:GetChildren()) do
			if child:IsA("Weld") and child.Name == "LockedSeatWeld" and child.Part1 == rootPart then
				hasWeld = true
				break
			end
		end
	
		if not hasWeld then
			local weld = Instance.new("Weld")
			weld.Name = "LockedSeatWeld"
			weld.Part0 = seat
			weld.Part1 = rootPart
			weld.C0 = CFrame.new(0, (seat.Size.Y / 2) + (rootPart.Size.Y / 2) - 0.1, 0)
			weld.Parent = seat
		end
	end
	
	local function unlockSeat()
		isLocked = false
		button.Text = "تثبيت على الكرسي"
	
		if heartbeatConn then
			heartbeatConn:Disconnect()
			heartbeatConn = nil
		end
	
		local character = player.Character
		local humanoid = getHumanoid(character)
		local rootPart = getRootPart(character)
	
		if humanoid then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			humanoid.JumpPower = savedJumpPower
		end
	
		clearSeatWeld(lockedSeat, rootPart)
		lockedSeat = nil
	end
	
	local function lockSeat()
		local character = player.Character
		local humanoid = getHumanoid(character)
		local rootPart = getRootPart(character)
		if not humanoid or not rootPart then return end
	
		local currentSeat = humanoid.SeatPart
		if not currentSeat or not (currentSeat:IsA("Seat") or currentSeat:IsA("VehicleSeat")) then
			return
		end
	
		isLocked = true
		lockedSeat = currentSeat
		savedJumpPower = humanoid.JumpPower > 0 and humanoid.JumpPower or 50
		button.Text = "فك التثبيت"
	
		keepSeated(lockedSeat, humanoid, rootPart)
	
		heartbeatConn = RunService.Heartbeat:Connect(function()
			local char = player.Character
			local hum = getHumanoid(char)
			local root = getRootPart(char)
	
			if not char or not char.Parent or not hum or not root or hum.Health <= 0 then
				unlockSeat()
				return
			end
	
			if not lockedSeat or not lockedSeat.Parent then
				unlockSeat()
				return
			end
	
			keepSeated(lockedSeat, hum, root)
		end)
	end
	
	button.Text = "تثبيت على الكرسي"
	
	button.MouseButton1Click:Connect(function()
		if isLocked then
			unlockSeat()
		else
			lockSeat()
		end
	end)
	
	player.CharacterAdded:Connect(function()
		unlockSeat()
	end)
end)

-- تشغيل برمجة: DragScript
task.spawn(function()
	local script = setmetatable({Parent = ui_ScriptFrame_3, Name = "DragScript"}, {__index = ui_ScriptFrame_3})
	local UserInputService = game:GetService("UserInputService")
	
	local frame = script.Parent
	local dragging = false
	local dragInput, dragStart, startPos
	
	local function update(input)
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
	
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
	
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			update(input)
		end
	end)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_MirageBtn_19, Name = "LocalScript"}, {__index = ui_MirageBtn_19})
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	local toggleButton = script.Parent -- الزر الرئيسي للتحكم
	
	-- ربط مباشر بـ ScreenGui باسم MirageGui داخل PlayerGui
	local playerGui = player:WaitForChild("PlayerGui")
	local mirageGui: ScreenGui = playerGui:WaitForChild("SeaHunterGui") :: ScreenGui
	local errorLabel: TextLabel = mirageGui:WaitForChild("ErrorLabel", true) :: TextLabel
	
	local buttonsFolder: Instance = mirageGui -- يبحث تلقائياً داخل MirageGui حتى لو كانت الأزرار داخل Frame
	local targetButtonNames = { "AnchorBtn", "MoveBtn", "SeaEnemys", "RocksBtn" }
	
	local boatsFolder = workspace:WaitForChild("Boats")
	local mapFolder = workspace:WaitForChild("Map")
	
	local TARGET_SPEED = 350
	local TWEEN_DURATION = 1.2 -- مدة التوين المخصص بالثواني
	local MIRAGE_TWEEN_DURATION = 2.0 -- مدة التوين لأعلى نقطة في MirageIsland
	
	local isActive = false
	local activeConnection: RBXScriptConnection? = nil
	local mirageConnection: RBXScriptConnection? = nil
	local errorThread: thread? = nil
	local currentBoat: Model? = nil
	local handledMirages: { [Model]: boolean } = {}
	
	-- الضغط على زر واجهة محدد بالاسم داخل MirageGui
	local function clickGuiButtonByName(btnName: string)
		local btn = buttonsFolder:FindFirstChild(btnName, true)
		if btn and btn:IsA("GuiButton") then
			if typeof(firesignal) == "function" then
				firesignal(btn.MouseButton1Click)
			else
				btn.Activated:Fire()
			end
		end
	end
	
	-- دالة إظهار رسالة الخطأ لمدة 3 ثوانٍ ثم إخفاؤها
	local function showErrorMessage(text: string)
		if errorThread then
			task.cancel(errorThread)
			errorThread = nil
		end
	
		errorLabel.Text = text
		errorLabel.Visible = true
	
		errorThread = task.delay(3, function()
			errorLabel.Visible = false
			errorThread = nil
		end)
	end
	
	-- البحث عن قارب يملك ObjectValue باسم Owner وقيمته تساوي اللاعب الحالي
	local function findPlayerBoat(): Model?
		for _, item in ipairs(boatsFolder:GetChildren()) do
			if item:IsA("Model") then
				local ownerValue = item:FindFirstChild("Owner")
				if ownerValue and ownerValue:IsA("ObjectValue") and ownerValue.Value == player then
					return item
				end
			end
		end
		return nil
	end
	
	-- إيجاد VehicleSeat داخل القارب
	local function findVehicleSeat(boat: Model): VehicleSeat?
		for _, desc in ipairs(boat:GetDescendants()) do
			if desc:IsA("VehicleSeat") then
				return desc
			end
		end
		return nil
	end
	
	-- إيقاف/فك التوين الحالي
	local function stopCurrentProcess()
		if activeConnection then
			activeConnection:Disconnect()
			activeConnection = nil
		end
	end
	
	-- حساب أعلى نقطة (أعلى قيمة Y) داخل موديل الجزيرة
	local function getHighestPointInModel(model: Model): Vector3?
		local highestY: number? = nil
		local bestXZ = Vector2.zero
	
		for _, desc in ipairs(model:GetDescendants()) do
			if desc:IsA("BasePart") then
				local topY = desc.Position.Y + (desc.Size.Y * 0.5)
				if highestY == nil or topY > highestY then
					highestY = topY
					bestXZ = Vector2.new(desc.Position.X, desc.Position.Z)
				end
			end
		end
	
		if highestY ~= nil then
			return Vector3.new(bestXZ.X, highestY + 4, bestXZ.Y)
		end
	
		local pivot = model:GetPivot()
		return pivot.Position + Vector3.new(0, 15, 0)
	end
	
	-- Tween مخصص بالكامل بدون TweenService لتحريك جزء إلى هدف ثم فك التوين
	local function customTweenToCFrame(
		targetPart: BasePart,
		targetPos: Vector3,
		duration: number,
		sitHumanoid: Humanoid?,
		seat: VehicleSeat?,
		onCompleted: (() -> ())?
	)
		stopCurrentProcess()
	
		local startCFrame = targetPart.CFrame
		local goalCFrame = CFrame.new(targetPos) * (startCFrame - startCFrame.Position)
		local elapsed = 0
	
		local function easeOutCubic(t: number): number
			return 1 - ((1 - t) ^ 3)
		end
	
		activeConnection = RunService.Heartbeat:Connect(function(dt: number)
			if not targetPart.Parent then
				stopCurrentProcess()
				return
			end
	
			elapsed += dt
			local alpha = math.clamp(elapsed / duration, 0, 1)
			local easedAlpha = easeOutCubic(alpha)
	
			targetPart.AssemblyLinearVelocity = Vector3.zero
			targetPart.AssemblyAngularVelocity = Vector3.zero
			targetPart.CFrame = startCFrame:Lerp(goalCFrame, easedAlpha)
	
			if alpha >= 1 then
				-- فك التوين فوراً عند الانتهاء
				stopCurrentProcess()
	
				if sitHumanoid and seat then
					seat:Sit(sitHumanoid)
				end
	
				if onCompleted then
					onCompleted()
				end
			end
		end)
	end
	
	-- ضبط والتحقق من القيم الثلاث لتصبح 350
	local function setAndVerifySpeeds(boat: Model, seat: VehicleSeat): boolean
		local speedObj = boat:FindFirstChild("Speed", true)
		if speedObj and speedObj:IsA("IntValue") then
			speedObj.Value = TARGET_SPEED
		end
	
		boat:SetAttribute("MaxSpeed", TARGET_SPEED)
		seat:SetAttribute("MaxSpeed", TARGET_SPEED)
	
		local controlObj = boat:FindFirstChild("control", true) or boat:FindFirstChild("Control", true)
		if controlObj then
			if controlObj:GetAttribute("MaxSpeed") ~= nil then
				controlObj:SetAttribute("MaxSpeed", TARGET_SPEED)
			end
	
			local controlMaxSpeed = controlObj:FindFirstChild("MaxSpeed", true)
			if controlMaxSpeed then
				if controlMaxSpeed:IsA("IntValue") or controlMaxSpeed:IsA("NumberValue") then
					controlMaxSpeed.Value = TARGET_SPEED
				elseif controlMaxSpeed:IsA("Configuration") or controlMaxSpeed:IsA("Folder") then
					controlMaxSpeed:SetAttribute("Value", TARGET_SPEED)
				end
			end
		end
	
		local speedOk = (speedObj and speedObj:IsA("IntValue") and speedObj.Value == TARGET_SPEED) or (speedObj == nil)
		local attrOk = (boat:GetAttribute("MaxSpeed") == TARGET_SPEED) or (seat:GetAttribute("MaxSpeed") == TARGET_SPEED)
	
		local controlOk = true
		if controlObj then
			local controlMaxSpeed = controlObj:FindFirstChild("MaxSpeed", true)
			if controlMaxSpeed and (controlMaxSpeed:IsA("IntValue") or controlMaxSpeed:IsA("NumberValue")) then
				controlOk = (controlMaxSpeed.Value == TARGET_SPEED)
			elseif controlObj:GetAttribute("MaxSpeed") ~= nil then
				controlOk = (controlObj:GetAttribute("MaxSpeed") == TARGET_SPEED)
			end
		end
	
		return speedOk and attrOk and controlOk
	end
	
	-- الضغط على الأزرار الأربعة بالترتيب
	local function triggerTargetGuiButtons()
		for _, btnName in ipairs(targetButtonNames) do
			if not isActive then
				return
			end
			clickGuiButtonByName(btnName)
			task.wait(0.08)
		end
	end
	
	-- إطفاء كل شيء عند الضغط مرة ثانية
	local function turnOffAll()
		isActive = false
		stopCurrentProcess()
	
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Sit then
			humanoid.Sit = false
			local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if rootPart then
				rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 3, -4)
			end
		end
	
		currentBoat = nil
	end
	
	-- تشغيل النظام عند الضغط لأول مرة
	local function turnOnAll()
		local boat = findPlayerBoat()
		if not boat then
			showErrorMessage("لا يوجد قارب لك اشتري قارب")
			isActive = false
			return
		end
	
		local seat = findVehicleSeat(boat)
		if not seat then
			showErrorMessage("لا يوجد قارب لك اشتري قارب")
			isActive = false
			return
		end
	
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local rootPart = character and (character:FindFirstChild("HumanoidRootPart") :: BasePart?)
	
		if not character or not humanoid or not rootPart then
			isActive = false
			return
		end
	
		isActive = true
		currentBoat = boat
	
		local aboveSeatPos = (seat.CFrame * CFrame.new(0, 2.5, 0)).Position
		customTweenToCFrame(rootPart, aboveSeatPos, TWEEN_DURATION, humanoid, seat, function()
			if not isActive then
				return
			end
	
			local timeout = os.clock() + 1.5
			while isActive and seat.Occupant ~= humanoid and os.clock() < timeout do
				task.wait(0.05)
			end
	
			if not isActive or seat.Occupant ~= humanoid then
				return
			end
	
			if setAndVerifySpeeds(boat, seat) then
				triggerTargetGuiButtons()
			end
		end)
	end
	
	-- معالجة ترسبن موديل MirageIsland داخل workspace.Map
	local function handleMirageIsland(model: Model)
		if not model:IsA("Model") or model.Name ~= "MirageIsland" then
			return
		end
		if handledMirages[model] then
			return
		end
		handledMirages[model] = true
	
		local waitUntil = os.clock() + 2
		while model.Parent and #model:GetDescendants() == 0 and os.clock() < waitUntil do
			task.wait(0.05)
		end
		if not model.Parent then
			return
		end
	
		-- 1) الضغط على AnchorBtn تلقائياً
		clickGuiButtonByName("AnchorBtn")
	
		-- 2) حساب أعلى نقطة في MirageIsland
		local highestTargetPos = getHighestPointInModel(model)
		if not highestTargetPos then
			return
		end
	
		local character = player.Character
		local rootPart = character and (character:FindFirstChild("HumanoidRootPart") :: BasePart?)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
		if not rootPart then
			return
		end
	
		local movePart: BasePart = rootPart
		if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("BasePart") then
			local seatPart = humanoid.SeatPart
			if currentBoat and seatPart:IsDescendantOf(currentBoat) and currentBoat.PrimaryPart then
				movePart = currentBoat.PrimaryPart
			elseif currentBoat and seatPart:IsDescendantOf(currentBoat) then
				movePart = seatPart
			end
		end
	
		-- 3) تنفيذ Tween مخصص لأعلى نقطة ثم فك التوين تلقائياً
		customTweenToCFrame(movePart, highestTargetPos, MIRAGE_TWEEN_DURATION, nil, nil, function()
			stopCurrentProcess()
		end)
	end
	
	-- رصد أي MirageIsland يترسبن داخل workspace.Map
	mirageConnection = mapFolder.DescendantAdded:Connect(function(descendant: Instance)
		if descendant:IsA("Model") and descendant.Name == "MirageIsland" then
			handleMirageIsland(descendant)
		end
	end)
	
	-- فحص إذا كان MirageIsland موجوداً مسبقاً داخل workspace.Map
	for _, desc in ipairs(mapFolder:GetDescendants()) do
		if desc:IsA("Model") and desc.Name == "MirageIsland" then
			task.spawn(handleMirageIsland, desc)
		end
	end
	
	toggleButton.MouseButton1Click:Connect(function()
		if isActive then
			turnOffAll()
		else
			turnOnAll()
		end
	end)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_ToggleBtn_21, Name = "LocalScript"}, {__index = ui_ToggleBtn_21})
	local button = script.Parent
	local frame = button.Parent:FindFirstChild("ScriptFrame")
	
	if not button:IsA("GuiButton") then
		warn("يجب وضع السكربت داخل زر (TextButton أو ImageButton)")
		return
	end
	
	if not frame or not frame:IsA("GuiObject") then
		warn("لم يتم العثور على ScriptFrame بنفس المستوى الأب للزر")
		return
	end
	
	-- ضبط الحالة الابتدائية (اختياري)
	frame.Visible = true
	
	button.MouseButton1Click:Connect(function()
		frame.Visible = not frame.Visible
	end)
end)
