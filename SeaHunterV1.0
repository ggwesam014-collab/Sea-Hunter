local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local mainButton = script.Parent -- الزر الأساسي (يكون غير مفعل في البداية)

local playerGui = player:WaitForChild("PlayerGui")
local seaHunterGui = playerGui:WaitForChild("SeaHunterGui")
local mainFrame = seaHunterGui:WaitForChild("MainFrame")
local scriptFrame = mainFrame:WaitForChild("scriptFrame")
local typeFrame = scriptFrame:WaitForChild("TypeFrame")

local sailBtn = typeFrame:WaitForChild("sailBtn")
local sailTypeBtn = typeFrame:WaitForChild("SailTypeBtn")
local errorLabel = typeFrame:FindFirstChild("ErrorLabel")
	or scriptFrame:FindFirstChild("ErrorLabel")
	or mainFrame:FindFirstChild("ErrorLabel")
	or seaHunterGui:FindFirstChild("ErrorLabel")

local rocksBtn = scriptFrame:WaitForChild("RocksBtn")
local anchorBtn = scriptFrame:WaitForChild("AnchorBtn")
local seaEnemysBtn = scriptFrame:WaitForChild("SeaEnemys")
local moveBtn = scriptFrame:WaitForChild("MoveBtn")

local TARGET_POS = Vector3.new(-17013.75, 1, 438.476)
local TARGET_SPEED = 350
local MOVE_SPEED_STUDS_PER_SEC = 180

local isArmed = false
local isRunning = false

local function findPlayerBoat()
	local boatsFolder = workspace:FindFirstChild("Boats")
	if not boatsFolder then
		return nil
	end

	for _, model in ipairs(boatsFolder:GetChildren()) do
		if model:IsA("Model") then
			local ownerObj = model:FindFirstChild("Owner")
			if ownerObj and ownerObj:IsA("ObjectValue") and ownerObj.Value == player then
				return model
			end
		end
	end

	return nil
end

local function showNoBoatError()
	if errorLabel then
		errorLabel.Text = "لا يوجد قارب للاعب اشتري قارب"
		errorLabel.Visible = true
	end
end

local function customTweenToSeat(seat: VehicleSeat, duration: number)
	local camera = workspace.CurrentCamera
	local startPos = camera.CFrame.Position
	local goalPos = seat.Position + Vector3.new(0, 6, 10)
	local elapsed = 0

	while elapsed < duration do
		local dt = RunService.RenderStepped:Wait()
		elapsed += dt
		local t = math.clamp(elapsed / duration, 0, 1)
		local eased = t < 0.5 and (4 * t * t * t) or (1 - ((-2 * t + 2) ^ 3) / 2)
		camera.CFrame = CFrame.lookAt(startPos:Lerp(goalPos, eased), seat.Position)
	end
end

local function setNoClip(boat: Model, enabled: boolean)
	local character = player.Character
	if character then
		for _, desc in ipairs(character:GetDescendants()) do
			if desc:IsA("BasePart") then
				desc.CanCollide = not enabled
			end
		end
	end

	if boat then
		for _, desc in ipairs(boat:GetDescendants()) do
			if desc:IsA("BasePart") then
				desc.CanCollide = not enabled
			end
		end
	end
end

local function applySpeedSettings(boat: Model, seat: VehicleSeat)
	local speedVal = boat:FindFirstChild("Speed")
	if speedVal and speedVal:IsA("IntValue") then
		speedVal.Value = TARGET_SPEED
	end

	seat:SetAttribute("MaxSpeed", TARGET_SPEED)

	local control = seat:FindFirstChild("control")
	if control then
		local controlMaxSpeed = control:FindFirstChild("MaxSpeed")
		if controlMaxSpeed and (controlMaxSpeed:IsA("NumberValue") or controlMaxSpeed:IsA("IntValue")) then
			controlMaxSpeed.Value = TARGET_SPEED
		elseif control:GetAttribute("MaxSpeed") ~= nil then
			control:SetAttribute("MaxSpeed", TARGET_SPEED)
		end
	end
end

local function triggerFourButtons()
	local buttons = { rocksBtn, anchorBtn, seaEnemysBtn, moveBtn }
	for _, btn in ipairs(buttons) do
		if btn and (btn:IsA("TextButton") or btn:IsA("ImageButton")) then
			if btn.Activated then
				btn.Activated:Fire()
			end
			if btn.MouseButton1Click then
				btn.MouseButton1Click:Fire()
			end
		end
	end
end

local function moveBoatWithoutTween(boat: Model)
	while boat.Parent do
		local pivot = boat:GetPivot()
		local currentPos = pivot.Position
		local delta = TARGET_POS - currentPos
		local distance = delta.Magnitude

		if distance <= 2 then
			boat:PivotTo(CFrame.new(TARGET_POS) * pivot.Rotation)
			break
		end

		local dt = RunService.Heartbeat:Wait()
		local step = math.min(distance, MOVE_SPEED_STUDS_PER_SEC * dt)
		local nextPos = currentPos + delta.Unit * step
		boat:PivotTo(CFrame.lookAt(nextPos, Vector3.new(TARGET_POS.X, nextPos.Y, TARGET_POS.Z)))
	end
end

local function startSailSequence()
	if isRunning then
		return
	end
	isRunning = true

	if sailTypeBtn and (sailTypeBtn:IsA("TextButton") or sailTypeBtn:IsA("TextLabel")) then
		sailTypeBtn.Text = "جزيرة الميراج..⬇"
	end

	local boat = findPlayerBoat()
	if not boat then
		showNoBoatError()
		isRunning = false
		return
	end

	if errorLabel then
		errorLabel.Visible = false
	end

	local seat = boat:FindFirstChildWhichIsA("VehicleSeat", true)
	if not seat then
		isRunning = false
		return
	end

	customTweenToSeat(seat, 1.2)

	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildWhichIsA("Humanoid")
	if humanoid and seat.Occupant ~= humanoid then
		seat:Sit(humanoid)
	end

	if not humanoid or seat.Occupant ~= humanoid then
		repeat
			task.wait(0.1)
		until not humanoid or seat.Occupant == humanoid
	end

	applySpeedSettings(boat, seat)
	setNoClip(boat, true)
	moveBoatWithoutTween(boat)

	local finalPos = boat:GetPivot().Position
	if (finalPos - TARGET_POS).Magnitude <= 3 then
		triggerFourButtons()
	end

	isRunning = false
end

mainButton.MouseButton1Click:Connect(function()
	if not mainButton.Active then
		mainButton.Active = true
	end
	isArmed = true
end)

sailBtn.MouseButton1Click:Connect(function()
	if not isArmed then
		return
	end
	startSailSequence()
end)
