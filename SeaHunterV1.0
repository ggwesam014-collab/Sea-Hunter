--// ==========================================
--// البرمجات المدمجة التي كانت داخل الواجهة
--// ==========================================

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_sailBtn_7, Name = "LocalScript"}, {__index = ui_sailBtn_7})
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	local GuiService = game:GetService("GuiService")
	
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local sailBtn = script.Parent
	
	local DESTINATION_POS = Vector3.new(-17013.75, 1, 438.476)
	
	local function findFirstDescendantByName(root, name)
		for _, obj in ipairs(root:GetDescendants()) do
			if obj.Name == name then
				return obj
			end
		end
		return nil
	end
	
	local errorLabel = findFirstDescendantByName(playerGui, "ErrorLabel")
	
	local isSailing = false
	local sessionCounter = 0
	local seatLockConn = nil
	local activeBoat = nil
	local expiredBoats = {} -- [boatModel] = true بعد موت اللاعب
	
	local function showError(msg)
		if errorLabel then
			errorLabel.Text = msg
			errorLabel.Visible = true
		end
	end
	
	local function clearError()
		if errorLabel then
			errorLabel.Visible = false
		end
	end
	
	local function clearExpiredBoats()
		table.clear(expiredBoats)
		clearError()
	end
	
	-- مراقبة ظهور قارب جديد يخص اللاعب داخل Workspace.Boats
	local function bindBoatModel(boatModel)
		if not boatModel:IsA("Model") then
			return
		end
	
		local function checkOwner()
			local ownerObj = boatModel:FindFirstChild("Owner")
			if ownerObj and ownerObj:IsA("ObjectValue") and ownerObj.Value == player then
				clearExpiredBoats()
			end
		end
	
		checkOwner()
	
		boatModel.ChildAdded:Connect(function(child)
			if child.Name == "Owner" and child:IsA("ObjectValue") then
				checkOwner()
				child:GetPropertyChangedSignal("Value"):Connect(checkOwner)
			end
		end)
	
		local existingOwner = boatModel:FindFirstChild("Owner")
		if existingOwner and existingOwner:IsA("ObjectValue") then
			existingOwner:GetPropertyChangedSignal("Value"):Connect(checkOwner)
		end
	end
	
	local function hookBoatsFolder(boatsFolder)
		if not boatsFolder then
			return
		end
	
		for _, child in ipairs(boatsFolder:GetChildren()) do
			bindBoatModel(child)
		end
	
		boatsFolder.ChildAdded:Connect(function(child)
			task.defer(function()
				bindBoatModel(child)
			end)
		end)
	end
	
	local existingBoatsFolder = Workspace:FindFirstChild("Boats")
	if existingBoatsFolder then
		hookBoatsFolder(existingBoatsFolder)
	end
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == "Boats" then
			hookBoatsFolder(child)
		end
	end)
	
	local function getCharParts()
		local char = player.Character or player.CharacterAdded:Wait()
		local hum = char:WaitForChild("Humanoid")
		local hrp = char:WaitForChild("HumanoidRootPart")
		return char, hum, hrp
	end
	
	-- توين مخصص عبر تحريك CFrame بسلاسة
	local function customTween(targetObj, goalCFrame, speed, sessionId)
		local isModel = targetObj:IsA("Model")
		local basePart = isModel and (targetObj.PrimaryPart or targetObj:FindFirstChildWhichIsA("BasePart")) or targetObj
		if not basePart then
			return false
		end
		if isModel and not targetObj.PrimaryPart then
			targetObj.PrimaryPart = basePart
		end
	
		local startCF = isModel and targetObj:GetPivot() or basePart.CFrame
		local dist = (goalCFrame.Position - startCF.Position).Magnitude
		if dist <= 0.25 then
			if isModel then
				targetObj:PivotTo(goalCFrame)
			else
				basePart.CFrame = goalCFrame
			end
			return true
		end
	
		local duration = math.max(dist / math.max(speed, 1), 0.05)
		local elapsed = 0
	
		while elapsed < duration do
			if not isSailing or sessionId ~= sessionCounter then
				return false
			end
			local dt = RunService.Heartbeat:Wait()
			elapsed += dt
			local t = math.clamp(elapsed / duration, 0, 1)
			local eased = t < 0.5 and (2 * t * t) or (1 - ((-2 * t + 2) ^ 2) / 2)
			local nextCF = startCF:Lerp(goalCFrame, eased)
	
			if isModel then
				targetObj:PivotTo(nextCF)
			else
				basePart.CFrame = nextCF
			end
		end
	
		if isModel then
			targetObj:PivotTo(goalCFrame)
		else
			basePart.CFrame = goalCFrame
		end
		return true
	end
	
	-- إرجاع (boat, status): status = "ok" | "no_boat" | "need_new_boat"
	local function getOwnedBoat()
		local boatsFolder = Workspace:FindFirstChild("Boats")
		if not boatsFolder then
			return nil, "no_boat"
		end
	
		local foundExpired = nil
	
		for _, boatModel in ipairs(boatsFolder:GetChildren()) do
			if boatModel:IsA("Model") then
				local ownerObj = boatModel:FindFirstChild("Owner")
				if ownerObj and ownerObj:IsA("ObjectValue") and ownerObj.Value == player then
					if expiredBoats[boatModel] then
						foundExpired = boatModel
					else
						return boatModel, "ok"
					end
				end
			end
		end
	
		if foundExpired then
			return nil, "need_new_boat"
		end
	
		return nil, "no_boat"
	end
	
	local function getVehicleSeat(boatModel)
		for _, item in ipairs(boatModel:GetDescendants()) do
			if item:IsA("VehicleSeat") and (item.Name == "vehcleSeat" or item.Name == "VehicleSeat" or item.Name:lower():find("seat")) then
				return item
			end
		end
		return boatModel:FindFirstChildWhichIsA("VehicleSeat", true)
	end
	
	local function lockSeat(seat)
		if seatLockConn then
			seatLockConn:Disconnect()
			seatLockConn = nil
		end
	
		local _, hum, hrp = getCharParts()
		if hum.Health <= 0 then
			return
		end
	
		if seat.Occupant ~= hum then
			hrp.CFrame = seat.CFrame * CFrame.new(0, 2.2, 0)
			seat:Sit(hum)
		end
	
		seatLockConn = RunService.Heartbeat:Connect(function()
			if not isSailing then
				return
			end
			local char = player.Character
			local h = char and char:FindFirstChildOfClass("Humanoid")
			local r = char and char:FindFirstChild("HumanoidRootPart")
			if h and r and h.Health > 0 and seat and seat.Parent then
				h.JumpPower = 0
				h.JumpHeight = 0
				h:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
				if seat.Occupant ~= h then
					r.CFrame = seat.CFrame * CFrame.new(0, 2.2, 0)
					seat:Sit(h)
				end
			end
		end)
	end
	
	local function unlockSeat()
		if seatLockConn then
			seatLockConn:Disconnect()
			seatLockConn = nil
		end
		local char = player.Character
		local h = char and char:FindFirstChildOfClass("Humanoid")
		if h then
			h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			h.JumpPower = 50
			h.JumpHeight = 7.2
			h.Sit = false
		end
	end
	
	local function setSpeedThreePlaces(seat)
		local speedVal = seat:FindFirstChild("Speed")
		if speedVal and (speedVal:IsA("IntValue") or speedVal:IsA("NumberValue")) then
			speedVal.Value = 350
		end
	
		seat:SetAttribute("MaxSpeed", 350)
	
		local controlObj = seat:FindFirstChild("control") or seat:FindFirstChild("Control")
		if controlObj then
			local maxSpeedVal = controlObj:FindFirstChild("MaxSpeed")
			if maxSpeedVal and (maxSpeedVal:IsA("IntValue") or maxSpeedVal:IsA("NumberValue")) then
				maxSpeedVal.Value = 350
			elseif controlObj:IsA("IntValue") or controlObj:IsA("NumberValue") then
				controlObj.Value = 350
			end
		end
	end
	
	local function driveAvoidingObstacles(boatModel, targetPos, speed, sessionId)
		local primary = boatModel.PrimaryPart or boatModel:FindFirstChildWhichIsA("BasePart")
		if not primary then
			return false
		end
		if not boatModel.PrimaryPart then
			boatModel.PrimaryPart = primary
		end
	
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.FilterDescendantsInstances = { boatModel, player.Character }
	
		while isSailing and sessionId == sessionCounter do
			local curPos = primary.Position
			local flatCur = Vector3.new(curPos.X, targetPos.Y, curPos.Z)
			local flatGoal = Vector3.new(targetPos.X, targetPos.Y, targetPos.Z)
			local delta = flatGoal - flatCur
			local dist = delta.Magnitude
	
			if dist <= 6 then
				local lookAtPos = Vector3.new(targetPos.X, curPos.Y, targetPos.Z)
				boatModel:PivotTo(CFrame.lookAt(lookAtPos, lookAtPos + delta.Unit))
				return true
			end
	
			local forwardDir = delta.Unit
			local hitFront = Workspace:Raycast(curPos + Vector3.new(0, 2, 0), forwardDir * 35, rayParams)
	
			local steerDir = forwardDir
			if hitFront then
				local rightVec = forwardDir:Cross(Vector3.new(0, 1, 0)).Unit
				local leftVec = -rightVec
				local hitRight = Workspace:Raycast(curPos + Vector3.new(0, 2, 0), (forwardDir + rightVec * 0.8).Unit * 38, rayParams)
				local hitLeft = Workspace:Raycast(curPos + Vector3.new(0, 2, 0), (forwardDir + leftVec * 0.8).Unit * 38, rayParams)
	
				if not hitRight then
					steerDir = (forwardDir + rightVec * 0.85).Unit
				elseif not hitLeft then
					steerDir = (forwardDir + leftVec * 0.85).Unit
				else
					steerDir = rightVec
				end
			end
	
			local dt = RunService.Heartbeat:Wait()
			local step = math.min(speed * dt, dist)
			local nextPos = curPos + (steerDir * step)
			boatModel:PivotTo(CFrame.lookAt(nextPos, nextPos + steerDir))
		end
	
		return false
	end
	
	local function moveRocks()
		local rocks = Workspace:FindFirstChild("Rocks")
		if rocks then
			rocks.Parent = ReplicatedStorage
		end
	end
	
	local function clickSeaEnemyButton()
		local seaHunterGui = playerGui:FindFirstChild("SeaHunterGui")
		local mainFrame = seaHunterGui and seaHunterGui:FindFirstChild("MainFrame")
		local scriptFrame = mainFrame and mainFrame:FindFirstChild("ScriptFrame")
		local seaEnemys = scriptFrame and scriptFrame:FindFirstChild("SeaEnemys")
		if not seaEnemys then
			return
		end
	
		for _, child in ipairs(seaEnemys:GetDescendants()) do
			if child:IsA("TextButton") or child:IsA("ImageButton") then
				if getconnections then
					for _, conn in ipairs(getconnections(child.MouseButton1Click)) do
						conn:Fire()
					end
					for _, conn in ipairs(getconnections(child.Activated)) do
						conn:Fire()
					end
				end
				pcall(function()
					child.Active = true
					GuiService.SelectedObject = child
				end)
				break
			end
		end
	end
	
	local function findTargetByKeyword(keyword)
		local lowerKey = string.lower(keyword)
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if string.find(string.lower(obj.Name), lowerKey) then
				if obj:IsA("BasePart") then
					return obj
				elseif obj:IsA("Model") then
					return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
				end
			end
		end
		return nil
	end
	
	local function isFullMoon()
		local moonLabel = findFirstDescendantByName(playerGui, "MoonStuts")
		if not moonLabel then
			return false
		end
	
		if moonLabel:IsA("TextLabel") or moonLabel:IsA("TextButton") then
			local textLower = string.lower(tostring(moonLabel.Text))
			if string.find(textLower, "full", 1, true) then
				return true
			end
		end
	
		return false
	end
	
	local function waitForFullMoon(sessionId)
		while isSailing and sessionId == sessionCounter do
			if isFullMoon() then
				return true
			end
			task.wait(0.5)
		end
		return false
	end
	
	local function stopRun(markActiveBoatExpired)
		if markActiveBoatExpired and activeBoat then
			expiredBoats[activeBoat] = true
		end
		isSailing = false
		sessionCounter += 1
		activeBoat = nil
		unlockSeat()
	end
	
	-- مراقبة موت اللاعب لفك القفل وتعليم القارب الحالي كمنتهي بعد الموت
	local function hookCharacterDeath(char)
		local hum = char:WaitForChild("Humanoid")
		hum.Died:Connect(function()
			if isSailing then
				stopRun(true)
				showError("الرجاء شراء قارب جديد")
			elseif activeBoat then
				expiredBoats[activeBoat] = true
				activeBoat = nil
			end
		end)
	end
	
	if player.Character then
		hookCharacterDeath(player.Character)
	end
	player.CharacterAdded:Connect(hookCharacterDeath)
	
	local function runSailFlow(modeType)
		clearError()
	
		local boat, status = getOwnedBoat()
		if not boat then
			if status == "need_new_boat" then
				showError("الرجاء شراء قارب جديد")
			else
				showError("لا يوجد قارب للاعب الرجاء شراء قارب")
			end
			return
		end
	
		local seat = getVehicleSeat(boat)
		if not seat then
			showError("لم يتم العثور على الكرسي في القارب")
			return
		end
	
		isSailing = true
		sessionCounter += 1
		activeBoat = boat
		local currentSession = sessionCounter
	
		task.spawn(function()
			if modeType == "Kitsune" then
				if not waitForFullMoon(currentSession) then
					return
				end
			end
	
			local seatTarget = seat.CFrame * CFrame.new(0, 1.5, 0)
			if not customTween(seat, seatTarget, 80, currentSession) then
				return
			end
	
			lockSeat(seat)
			task.wait(0.25)
	
			local _, hum = getCharParts()
			if hum.Health <= 0 then
				return
			end
	
			if hum.SeatPart ~= seat then
				lockSeat(seat)
				task.wait(0.25)
			end
	
			setSpeedThreePlaces(seat)
	
			if not driveAvoidingObstacles(boat, DESTINATION_POS, 350, currentSession) then
				return
			end
	
			local primary = boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart")
			if primary then
				local flatDist = (Vector3.new(primary.Position.X, DESTINATION_POS.Y, primary.Position.Z) - DESTINATION_POS).Magnitude
				if flatDist > 12 then
					customTween(boat, CFrame.new(DESTINATION_POS.X, primary.Position.Y, DESTINATION_POS.Z), 350, currentSession)
				end
			end
	
			moveRocks()
			clickSeaEnemyButton()
	
			local keyword = (modeType == "Kitsune") and "kitsune" or "mirage"
			while isSailing and currentSession == sessionCounter do
				local targetObj = findTargetByKeyword(keyword)
				if targetObj then
					customTween(boat, CFrame.new(targetObj.Position + Vector3.new(0, 10, 0)), 350, currentSession)
					break
				end
	
				local curPrimary = boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart")
				if curPrimary then
					if not boat.PrimaryPart then
						boat.PrimaryPart = curPrimary
					end
					local nextForward = curPrimary.CFrame * CFrame.new(0, 0, -25)
					customTween(boat, nextForward, 250, currentSession)
				end
	
				task.wait(0.2)
			end
		end)
	end
	
	sailBtn.MouseButton1Click:Connect(function()
		if isSailing then
			stopRun(false)
			return
		end
	
		local chosenType = playerGui:GetAttribute("SelectedSailType")
		if chosenType == "Mirage" or chosenType == "Kitsune" then
			runSailFlow(chosenType)
		end
	end)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_SailTypeBtn_8, Name = "LocalScript"}, {__index = ui_SailTypeBtn_8})
	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local sailTypeBtn = script.Parent
	
	local function findFirstDescendantByName(root, name)
		for _, obj in ipairs(root:GetDescendants()) do
			if obj.Name == name then
				return obj
			end
		end
		return nil
	end
	
	local mirageBtn = findFirstDescendantByName(playerGui, "MirageBtn")
	local kitsuneBtn = findFirstDescendantByName(playerGui, "KitsuneBtn")
	
	-- تحديد الفريم تلقائياً عبر الزرين MirageBtn أو KitsuneBtn، أو بالاسم الشائع
	local typeFrame = (mirageBtn and mirageBtn:FindFirstAncestorOfClass("Frame"))
		or (kitsuneBtn and kitsuneBtn:FindFirstAncestorOfClass("Frame"))
		or findFirstDescendantByName(playerGui, "TypeFrame")
		or findFirstDescendantByName(playerGui, "SailTypeFrame")
	
	if not mirageBtn then
		warn("[SailTypeBtn] لم يتم العثور على زر MirageBtn في PlayerGui")
	end
	if not kitsuneBtn then
		warn("[SailTypeBtn] لم يتم العثور على زر KitsuneBtn في PlayerGui")
	end
	if not typeFrame then
		warn("[SailTypeBtn] لم يتم العثور على الفريم الذي يحتوي على الأزرار في PlayerGui")
	end
	
	-- قيمة افتراضية مشتركة مع سكربت sailBtn
	if playerGui:GetAttribute("SelectedSailType") == nil then
		playerGui:SetAttribute("SelectedSailType", "Mirage")
	end
	
	if typeFrame then
		typeFrame.Visible = false
	end
	
	local function toggleTypeFrame()
		if not typeFrame then
			typeFrame = (mirageBtn and mirageBtn:FindFirstAncestorOfClass("Frame"))
				or (kitsuneBtn and kitsuneBtn:FindFirstAncestorOfClass("Frame"))
				or findFirstDescendantByName(playerGui, "TypeFrame")
		end
		if typeFrame then
			typeFrame.Visible = not typeFrame.Visible
		end
	end
	
	if sailTypeBtn:IsA("GuiButton") then
		sailTypeBtn.Activated:Connect(toggleTypeFrame)
		sailTypeBtn.MouseButton1Click:Connect(toggleTypeFrame)
	end
	
	if mirageBtn and mirageBtn:IsA("GuiButton") then
		local function selectMirage()
			playerGui:SetAttribute("SelectedSailType", "Mirage")
			if typeFrame then
				typeFrame.Visible = false
			end
		end
		mirageBtn.Activated:Connect(selectMirage)
		mirageBtn.MouseButton1Click:Connect(selectMirage)
	end
	
	if kitsuneBtn and kitsuneBtn:IsA("GuiButton") then
		local function selectKitsune()
			playerGui:SetAttribute("SelectedSailType", "Kitsune")
			if typeFrame then
				typeFrame.Visible = false
			end
		end
		kitsuneBtn.Activated:Connect(selectKitsune)
		kitsuneBtn.MouseButton1Click:Connect(selectKitsune)
	end
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_TextButton_15, Name = "LocalScript"}, {__index = ui_TextButton_15})
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	local button = script.Parent -- السكربت موجود داخل الزر مباشرة
	local throttleFrame = button.Parent -- الفريم المسمى Throttle
	
	-- عدّل هذا السطر إذا كان الليبل في مكان آخر، مثلاً: throttleFrame.Parent:FindFirstChild("TextLabel")
	local speedLabel = throttleFrame:FindFirstChild("TextLabel") or (throttleFrame.Parent and throttleFrame.Parent:FindFirstChild("TextLabel"))
	
	local MIN_SPEED = 0
	local MAX_SPEED = 350
	local dragging = false
	
	-- ضبط الزر ليبدأ من أقصى اليسار في منتصف الفريم عمودياً
	button.AnchorPoint = Vector2.new(0, 0.5)
	button.Position = UDim2.new(0, 0, 0.5, 0)
	if speedLabel and speedLabel:IsA("TextLabel") then
		speedLabel.Text = tostring(MIN_SPEED)
	end
	
	-- دالة للبحث عن موديل القارب والمقعد الذي يجلس فيه اللاعب
	local function getActiveBoatAndSeat()
		local character = player.Character
		if not character then return nil, nil end
	
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		if not seat or not seat:IsA("VehicleSeat") then return nil, nil end
	
		local boatsFolder = workspace:FindFirstChild("Boats")
		if boatsFolder and seat:IsDescendantOf(boatsFolder) then
			for _, boatModel in ipairs(boatsFolder:GetChildren()) do
				if seat:IsDescendantOf(boatModel) then
					return boatModel, seat
				end
			end
		end
	
		return seat.Parent, seat
	end
	
	-- دالة لتحديث القيم الثلاث بنفس الرقم
	local function applySpeedValues(targetSpeed)
		local boatModel, seat = getActiveBoatAndSeat()
		if not seat then return end
	
		-- 1. تحديث IntValue باسم Speed داخل القارب أو المقعد
		local speedValue = (boatModel and boatModel:FindFirstChild("Speed", true)) or seat:FindFirstChild("Speed", true)
		if speedValue and (speedValue:IsA("IntValue") or speedValue:IsA("NumberValue")) then
			speedValue.Value = targetSpeed
		end
	
		-- 2. تحديث MaxSpeed داخل control (سواء كائن قيمة أو Attribute)
		local control = seat:FindFirstChild("control")
		if control then
			local maxSpeedObj = control:FindFirstChild("MaxSpeed")
			if maxSpeedObj and (maxSpeedObj:IsA("IntValue") or maxSpeedObj:IsA("NumberValue")) then
				maxSpeedObj.Value = targetSpeed
			end
			if control:GetAttribute("MaxSpeed") ~= nil or typeof(targetSpeed) == "number" then
				control:SetAttribute("MaxSpeed", targetSpeed)
			end
		end
	
		-- 3. تحديث Attribute باسم MaxSpeed على المقعد أو القارب
		seat:SetAttribute("MaxSpeed", targetSpeed)
		if boatModel then
			boatModel:SetAttribute("MaxSpeed", targetSpeed)
		end
	
		-- تحديث خاصية المقعد نفسها
		seat.MaxSpeed = targetSpeed
	end
	
	-- حساب موقع الزر داخل حدود الفريم وتحديث الرقم
	local function updateThrottleFromInputX(inputX)
		if not throttleFrame or not throttleFrame:IsA("GuiObject") then return end
	
		local frameStartX = throttleFrame.AbsolutePosition.X
		local frameWidth = throttleFrame.AbsoluteSize.X
		local buttonWidth = button.AbsoluteSize.X
	
		local maxOffsetX = frameWidth - buttonWidth
		if maxOffsetX <= 0 then return end
	
		local desiredX = inputX - frameStartX - (buttonWidth * 0.5)
		local clampedX = math.clamp(desiredX, 0, maxOffsetX)
	
		button.Position = UDim2.new(0, clampedX, 0.5, 0)
	
		local ratio = clampedX / maxOffsetX
		local speedValueNum = math.round(MIN_SPEED + (ratio * (MAX_SPEED - MIN_SPEED)))
	
		if speedLabel and speedLabel:IsA("TextLabel") then
			speedLabel.Text = tostring(speedValueNum)
		end
	
		applySpeedValues(speedValueNum)
	end
	
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateThrottleFromInputX(input.Position.X)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	
	RunService.RenderStepped:Connect(function()
		if dragging then
			local mousePos = UserInputService:GetMouseLocation()
			updateThrottleFromInputX(mousePos.X)
		end
	end)
end)

