-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_DestroyBtn_6, Name = "LocalScript"}, {__index = ui_DestroyBtn_6})
	local button = script.Parent
	local screenGui = button:FindFirstAncestorOfClass("ScreenGui")
	local targetFrame = screenGui:WaitForChild("DestroyFrame") -- غيّر MainFrame إلى اسم الفريم
	
	button.MouseButton1Click:Connect(function()
		targetFrame.Visible = true
	end)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_SailTypeBtn_8, Name = "LocalScript"}, {__index = ui_SailTypeBtn_8})
	local TweenService = game:GetService("TweenService")
	
	local button = script.Parent
	local screenGui = button:FindFirstAncestorOfClass("ScreenGui")
	local targetFrame = screenGui:WaitForChild("TypeFrame") -- غيّر MainFrame إلى اسم الفريم
	
	local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local isTweening = false
	
	button.MouseButton1Click:Connect(function()
		if isTweening then return end
		isTweening = true
	
		if not targetFrame.Visible then
			targetFrame.Visible = true
			local showTween = TweenService:Create(targetFrame, tweenInfo, { GroupTransparency = 0 }) -- يتطلب CanvasGroup
			showTween:Play()
			showTween.Completed:Wait()
		else
			local hideTween = TweenService:Create(targetFrame, tweenInfo, { GroupTransparency = 1 }) -- يتطلب CanvasGroup
			hideTween:Play()
			hideTween.Completed:Wait()
			targetFrame.Visible = false
		end
	
		isTweening = false
	end)
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_TextButton_10, Name = "LocalScript"}, {__index = ui_TextButton_10})
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	local button = script.Parent -- السكربت موجود داخل الزر مباشرة
	local throttleFrame = button.Parent -- الفريم المسمى Throttle
	
	-- عدّل هذا السطر إذا كان الليبل في مكان آخر، مثلاً: throttleFrame.Parent:FindFirstChild("TextLabel")
	local speedLabel = throttleFrame:FindFirstChild("TextLabel") or (throttleFrame.Parent and throttleFrame.Parent:FindFirstChild("TextLabel"))
	
	local MIN_SPEED = 0
	local MAX_SPEED = 350
	local dragging = false
	
	-- ضبط الزر ليبدأ من أقصى اليسار في منتصف الفريم عمودياً
	button.AnchorPoint = Vector2.new(0, 0.5)
	button.Position = UDim2.new(0, 0, 0.5, 0)
	if speedLabel and speedLabel:IsA("TextLabel") then
		speedLabel.Text = tostring(MIN_SPEED)
	end
	
	-- دالة للبحث عن موديل القارب والمقعد الذي يجلس فيه اللاعب
	local function getActiveBoatAndSeat()
		local character = player.Character
		if not character then return nil, nil end
	
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		if not seat or not seat:IsA("VehicleSeat") then return nil, nil end
	
		local boatsFolder = workspace:FindFirstChild("Boats")
		if boatsFolder and seat:IsDescendantOf(boatsFolder) then
			for _, boatModel in ipairs(boatsFolder:GetChildren()) do
				if seat:IsDescendantOf(boatModel) then
					return boatModel, seat
				end
			end
		end
	
		return seat.Parent, seat
	end
	
	-- دالة لتحديث القيم الثلاث بنفس الرقم
	local function applySpeedValues(targetSpeed)
		local boatModel, seat = getActiveBoatAndSeat()
		if not seat then return end
	
		-- 1. تحديث IntValue باسم Speed داخل القارب أو المقعد
		local speedValue = (boatModel and boatModel:FindFirstChild("Speed", true)) or seat:FindFirstChild("Speed", true)
		if speedValue and (speedValue:IsA("IntValue") or speedValue:IsA("NumberValue")) then
			speedValue.Value = targetSpeed
		end
	
		-- 2. تحديث MaxSpeed داخل control (سواء كائن قيمة أو Attribute)
		local control = seat:FindFirstChild("control")
		if control then
			local maxSpeedObj = control:FindFirstChild("MaxSpeed")
			if maxSpeedObj and (maxSpeedObj:IsA("IntValue") or maxSpeedObj:IsA("NumberValue")) then
				maxSpeedObj.Value = targetSpeed
			end
			if control:GetAttribute("MaxSpeed") ~= nil or typeof(targetSpeed) == "number" then
				control:SetAttribute("MaxSpeed", targetSpeed)
			end
		end
	
		-- 3. تحديث Attribute باسم MaxSpeed على المقعد أو القارب
		seat:SetAttribute("MaxSpeed", targetSpeed)
		if boatModel then
			boatModel:SetAttribute("MaxSpeed", targetSpeed)
		end
	
		-- تحديث خاصية المقعد نفسها
		seat.MaxSpeed = targetSpeed
	end
	
	-- حساب موقع الزر داخل حدود الفريم وتحديث الرقم
	local function updateThrottleFromInputX(inputX)
		if not throttleFrame or not throttleFrame:IsA("GuiObject") then return end
	
		local frameStartX = throttleFrame.AbsolutePosition.X
		local frameWidth = throttleFrame.AbsoluteSize.X
		local buttonWidth = button.AbsoluteSize.X
	
		local maxOffsetX = frameWidth - buttonWidth
		if maxOffsetX <= 0 then return end
	
		local desiredX = inputX - frameStartX - (buttonWidth * 0.5)
		local clampedX = math.clamp(desiredX, 0, maxOffsetX)
	
		button.Position = UDim2.new(0, clampedX, 0.5, 0)
	
		local ratio = clampedX / maxOffsetX
		local speedValueNum = math.round(MIN_SPEED + (ratio * (MAX_SPEED - MIN_SPEED)))
	
		if speedLabel and speedLabel:IsA("TextLabel") then
			speedLabel.Text = tostring(speedValueNum)
		end
	
		applySpeedValues(speedValueNum)
	end
	
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateThrottleFromInputX(input.Position.X)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	
	RunService.RenderStepped:Connect(function()
		if dragging then
			local mousePos = UserInputService:GetMouseLocation()
			updateThrottleFromInputX(mousePos.X)
		end
	end)
end)

