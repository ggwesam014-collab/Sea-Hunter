-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_MoonStuts_18, Name = "LocalScript"}, {__index = ui_MoonStuts_18})
	local Lighting = game:GetService("Lighting")
	local label = script.Parent
	
	if not label:IsA("TextLabel") then
		warn("يجب وضع السكربت داخل TextLabel")
		return
	end
	
	local TOTAL_PHASES = 8
	local FULL_MOON_PHASE = 5 -- البدر يقع في الطور رقم 5
	
	-- ترتيب الأطوار من 1 إلى 8 وعدد الليالي المتبقية للوصول إلى الطور 5 (Full Moon)
	local MoonPhases = {
		["9709150401"] = { Index = 1, Name = "New Moon", NightsToFull = 4 },
		["9709150086"] = { Index = 2, Name = "Waxing Crescent", NightsToFull = 3 },
		["9709149680"] = { Index = 3, Name = "First Quarter", NightsToFull = 2 },
		["9709149052"] = { Index = 4, Name = "Waxing Gibbous", NightsToFull = 1 },
		["9709149431"] = { Index = 5, Name = "Full Moon", NightsToFull = 0 },
		["9709143733"] = { Index = 6, Name = "Waning Gibbous", NightsToFull = 7 },
		["9709139597"] = { Index = 7, Name = "Third Quarter", NightsToFull = 6 },
		["9709135895"] = { Index = 8, Name = "Waning Crescent", NightsToFull = 5 },
	}
	
	local function getAssetId(textureStr)
		if type(textureStr) ~= "string" then
			return nil
		end
		return string.match(textureStr, "%d+")
	end
	
	local function isNight(clockTime)
		-- الليل يبدأ من 18:00 وحتى 06:00
		return clockTime >= 18 or clockTime < 6
	end
	
	local function getWhenFullMoonText(phaseInfo, clockTime)
		local nightNow = isNight(clockTime)
	
		-- الحالة 1: الطور 5 والوقت ليل (Full Moon شغال الآن)
		if phaseInfo.Index == FULL_MOON_PHASE and nightNow then
			return "الفل مون: الآن (نشط)"
		end
	
		-- الحالة 2: الطور 5 لكن الوقت نهار (سيظهر الليلة عند الساعة 18:00)
		if phaseInfo.Index == FULL_MOON_PHASE and not nightNow then
			local hoursLeftInGame = 18 - clockTime
			local realMinutesLeft = math.max(0, hoursLeftInGame) -- 1 دقيقة حقيقية ≈ 1 ساعة داخل اللعبة
			return string.format("الفل مون: الليلة (بعد ~%.1f د)", realMinutesLeft)
		end
	
		-- الحالة 3: أي طور آخر -> نحسب عدد الليالي المتبقية للوصول للطور 5
		-- ملاحظة: كل ليلة في اللعبة تعادل 24 دقيقة واقعية تقريباً
		local nightsLeft = phaseInfo.NightsToFull
		local approxMinutes = nightsLeft * 24
	
		if nightsLeft == 1 then
			return string.format("الفل مون: الليلة القادمة (~%d د)", approxMinutes)
		else
			return string.format("الفل مون: بعد %d ليالٍ (~%d د)", nightsLeft, approxMinutes)
		end
	end
	
	local function updateUI()
		local sky = Lighting:FindFirstChildOfClass("Sky")
		if not sky then
			label.Text = "? / 8 | الفل مون: غير معروف"
			return
		end
	
		local assetId = getAssetId(sky.MoonTextureId)
		local phaseInfo = assetId and MoonPhases[assetId]
	
		if not phaseInfo then
			label.Text = "? / 8 | الفل مون: طور غير مسجل"
			return
		end
	
		local statusText = getWhenFullMoonText(phaseInfo, Lighting.ClockTime)
		label.Text = string.format("%d / %d | %s", phaseInfo.Index, TOTAL_PHASES, statusText)
	end
	
	-- تحديث فوري عند تغير الوقت أو صورة القمر أو إضافة Sky
	Lighting:GetPropertyChangedSignal("ClockTime"):Connect(updateUI)
	
	Lighting.ChildAdded:Connect(function(child)
		if child:IsA("Sky") then
			updateUI()
			child:GetPropertyChangedSignal("MoonTextureId"):Connect(updateUI)
		end
	end)
	
	local existingSky = Lighting:FindFirstChildOfClass("Sky")
	if existingSky then
		existingSky:GetPropertyChangedSignal("MoonTextureId"):Connect(updateUI)
	end
	
	updateUI()
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_Clock_19, Name = "LocalScript"}, {__index = ui_Clock_19})
	local Lighting = game:GetService("Lighting")
	local label = script.Parent
	
	if not label:IsA("TextLabel") then
		warn("يجب وضع السكربت داخل TextLabel")
		return
	end
	
	local function isNight(clockTime)
		return clockTime >= 18 or clockTime < 6
	end
	
	local function formatClockTimeHMS(clockTime)
		local normalized = clockTime % 24
		local totalSeconds = math.floor(normalized * 3600)
	
		local hours = math.floor(totalSeconds / 3600) % 24
		local minutes = math.floor((totalSeconds % 3600) / 60)
		local seconds = totalSeconds % 60
	
		return string.format("%02d:%02d:%02d", hours, minutes, seconds)
	end
	
	local function updateClockLabel()
		local clockTime = Lighting.ClockTime
		local formatted = formatClockTimeHMS(clockTime)
		local period = isNight(clockTime) and "ليل" or "نهار"
	
		label.Text = string.format("الساعة: %s (%s)", formatted, period)
	end
	
	Lighting:GetPropertyChangedSignal("ClockTime"):Connect(updateClockLabel)
	updateClockLabel()
end)

-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_AnchorBtn_20, Name = "LocalScript"}, {__index = ui_AnchorBtn_20})
	local button = script.Parent
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	
	local isLocked = false
	local lockedSeat = nil
	local heartbeatConn = nil
	local savedJumpPower = 50
	
	local function getRootPart(character)
		return character and character:FindFirstChild("HumanoidRootPart")
	end
	
	local function getHumanoid(character)
		return character and character:FindFirstChildOfClass("Humanoid")
	end
	
	local function clearSeatWeld(seat, rootPart)
		if not seat or not rootPart then return end
		for _, child in ipairs(seat:GetChildren()) do
			if child:IsA("Weld") and child.Name == "LockedSeatWeld" and child.Part1 == rootPart then
				child:Destroy()
			end
		end
	end
	
	local function keepSeated(seat, humanoid, rootPart)
		if not seat or not seat.Parent or not humanoid or not rootPart then return end
	
		-- منع القفز
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 0
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	
		-- إرجاع الجلوس إذا تم إخراجه بأي مؤثر أو دفع
		if humanoid.SeatPart ~= seat then
			seat:Sit(humanoid)
		end
	
		-- تثبيت اللاعب على الكرسي عبر Weld لمنع الإزاحة أو الطرد الفيزيائي
		local hasWeld = false
		for _, child in ipairs(seat:GetChildren()) do
			if child:IsA("Weld") and child.Name == "LockedSeatWeld" and child.Part1 == rootPart then
				hasWeld = true
				break
			end
		end
	
		if not hasWeld then
			local weld = Instance.new("Weld")
			weld.Name = "LockedSeatWeld"
			weld.Part0 = seat
			weld.Part1 = rootPart
			weld.C0 = CFrame.new(0, (seat.Size.Y / 2) + (rootPart.Size.Y / 2) - 0.1, 0)
			weld.Parent = seat
		end
	end
	
	local function unlockSeat()
		isLocked = false
		button.Text = "تثبيت على الكرسي"
	
		if heartbeatConn then
			heartbeatConn:Disconnect()
			heartbeatConn = nil
		end
	
		local character = player.Character
		local humanoid = getHumanoid(character)
		local rootPart = getRootPart(character)
	
		if humanoid then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			humanoid.JumpPower = savedJumpPower
		end
	
		clearSeatWeld(lockedSeat, rootPart)
		lockedSeat = nil
	end
	
	local function lockSeat()
		local character = player.Character
		local humanoid = getHumanoid(character)
		local rootPart = getRootPart(character)
		if not humanoid or not rootPart then return end
	
		local currentSeat = humanoid.SeatPart
		if not currentSeat or not (currentSeat:IsA("Seat") or currentSeat:IsA("VehicleSeat")) then
			return
		end
	
		isLocked = true
		lockedSeat = currentSeat
		savedJumpPower = humanoid.JumpPower > 0 and humanoid.JumpPower or 50
		button.Text = "فك التثبيت"
	
		keepSeated(lockedSeat, humanoid, rootPart)
	
		heartbeatConn = RunService.Heartbeat:Connect(function()
			local char = player.Character
			local hum = getHumanoid(char)
			local root = getRootPart(char)
	
			if not char or not char.Parent or not hum or not root or hum.Health <= 0 then
				unlockSeat()
				return
			end
	
			if not lockedSeat or not lockedSeat.Parent then
				unlockSeat()
				return
			end
	
			keepSeated(lockedSeat, hum, root)
		end)
	end
	
	button.Text = "تثبيت على الكرسي"
	
	button.MouseButton1Click:Connect(function()
		if isLocked then
			unlockSeat()
		else
			lockSeat()
		end
	end)
	
	player.CharacterAdded:Connect(function()
		unlockSeat()
	end)
end)

-- تشغيل برمجة: DragScript
task.spawn(function()
	local script = setmetatable({Parent = ui_ScriptFrame_3, Name = "DragScript"}, {__index = ui_ScriptFrame_3})
	local UserInputService = game:GetService("UserInputService")
	
	local frame = script.Parent
	local dragging = false
	local dragInput, dragStart, startPos
	
	local function update(input)
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
	
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
	
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			update(input)
		end
	end)
end)

