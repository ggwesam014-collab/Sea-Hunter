local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local toggleButton = script.Parent -- الزر الرئيسي للتحكم

-- ربط مباشر بـ ScreenGui باسم SeaHunterGui ومسار ErrorLabel الدقيق
local playerGui = player:WaitForChild("PlayerGui")
local seaHunterGui: ScreenGui = playerGui:WaitForChild("SeaHunterGui") :: ScreenGui
local mainFrame = seaHunterGui:WaitForChild("MainFrame")
local scriptFrame = mainFrame:WaitForChild("ScriptFrame")
local errorLabel: TextLabel = scriptFrame:WaitForChild("ErrorLabel") :: TextLabel

local buttonsFolder: Instance = seaHunterGui -- يبحث تلقائياً داخل SeaHunterGui
local targetButtonNames = { "AnchorBtn", "MoveBtn", "SeaEnemys", "RocksBtn" }

local boatsFolder = workspace:WaitForChild("Boats")
local mapFolder = workspace:WaitForChild("Map")

local TARGET_SPEED = 350
local TWEEN_DURATION = 1.2 -- مدة التوين المخصص بالثواني
local MIRAGE_TWEEN_DURATION = 2.0 -- مدة التوين لأعلى نقطة في MirageIsland

local isActive = false
local activeConnection: RBXScriptConnection? = nil
local mirageConnection: RBXScriptConnection? = nil
local errorThread: thread? = nil
local currentBoat: Model? = nil
local handledMirages: { [Model]: boolean } = {}

-- الضغط على زر واجهة محدد بالاسم داخل SeaHunterGui
local function clickGuiButtonByName(btnName: string)
	local btn = buttonsFolder:FindFirstChild(btnName, true)
	if btn and btn:IsA("GuiButton") then
		if typeof(firesignal) == "function" then
			firesignal(btn.MouseButton1Click)
		else
			btn.Activated:Fire()
		end
	end
end

-- دالة إظهار رسالة الخطأ لمدة 3 ثوانٍ ثم إخفاؤها
local function showErrorMessage(text: string)
	if errorThread then
		task.cancel(errorThread)
		errorThread = nil
	end

	errorLabel.Text = text
	errorLabel.Visible = true

	errorThread = task.delay(3, function()
		errorLabel.Visible = false
		errorThread = nil
	end)
end

-- البحث عن قارب يملك ObjectValue باسم Owner وقيمته تساوي اللاعب الحالي
local function findPlayerBoat(): Model?
	for _, item in ipairs(boatsFolder:GetChildren()) do
		if item:IsA("Model") then
			local ownerValue = item:FindFirstChild("Owner")
			if ownerValue and ownerValue:IsA("ObjectValue") and ownerValue.Value == player then
				return item
			end
		end
	end
	return nil
end

-- إيجاد VehicleSeat داخل القارب
local function findVehicleSeat(boat: Model): VehicleSeat?
	for _, desc in ipairs(boat:GetDescendants()) do
		if desc:IsA("VehicleSeat") then
			return desc
		end
	end
	return nil
end

-- إيقاف/فك التوين الحالي
local function stopCurrentProcess()
	if activeConnection then
		activeConnection:Disconnect()
		activeConnection = nil
	end
end

-- حساب أعلى نقطة (أعلى قيمة Y) داخل موديل الجزيرة
local function getHighestPointInModel(model: Model): Vector3?
	local highestY: number? = nil
	local bestXZ = Vector2.zero

	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") then
			local topY = desc.Position.Y + (desc.Size.Y * 0.5)
			if highestY == nil or topY > highestY then
				highestY = topY
				bestXZ = Vector2.new(desc.Position.X, desc.Position.Z)
			end
		end
	end

	if highestY ~= nil then
		return Vector3.new(bestXZ.X, highestY + 4, bestXZ.Y)
	end

	local pivot = model:GetPivot()
	return pivot.Position + Vector3.new(0, 15, 0)
end

-- Tween مخصص بالكامل بدون TweenService لتحريك جزء إلى هدف ثم فك التوين
local function customTweenToCFrame(
	targetPart: BasePart,
	targetPos: Vector3,
	duration: number,
	sitHumanoid: Humanoid?,
	seat: VehicleSeat?,
	onCompleted: (() -> ())?
)
	stopCurrentProcess()

	local startCFrame = targetPart.CFrame
	local goalCFrame = CFrame.new(targetPos) * (startCFrame - startCFrame.Position)
	local elapsed = 0

	local function easeOutCubic(t: number): number
		return 1 - ((1 - t) ^ 3)
	end

	activeConnection = RunService.Heartbeat:Connect(function(dt: number)
		if not targetPart.Parent then
			stopCurrentProcess()
			return
		end

		elapsed += dt
		local alpha = math.clamp(elapsed / duration, 0, 1)
		local easedAlpha = easeOutCubic(alpha)

		targetPart.AssemblyLinearVelocity = Vector3.zero
		targetPart.AssemblyAngularVelocity = Vector3.zero
		targetPart.CFrame = startCFrame:Lerp(goalCFrame, easedAlpha)

		if alpha >= 1 then
			-- فك التوين فوراً عند الانتهاء
			stopCurrentProcess()

			if sitHumanoid and seat then
				seat:Sit(sitHumanoid)
			end

			if onCompleted then
				onCompleted()
			end
		end
	end)
end

-- ضبط والتحقق من القيم الثلاث لتصبح 350
local function setAndVerifySpeeds(boat: Model, seat: VehicleSeat): boolean
	local speedObj = boat:FindFirstChild("Speed", true)
	if speedObj and speedObj:IsA("IntValue") then
		speedObj.Value = TARGET_SPEED
	end

	boat:SetAttribute("MaxSpeed", TARGET_SPEED)
	seat:SetAttribute("MaxSpeed", TARGET_SPEED)

	local controlObj = boat:FindFirstChild("control", true) or boat:FindFirstChild("Control", true)
	if controlObj then
		if controlObj:GetAttribute("MaxSpeed") ~= nil then
			controlObj:SetAttribute("MaxSpeed", TARGET_SPEED)
		end

		local controlMaxSpeed = controlObj:FindFirstChild("MaxSpeed", true)
		if controlMaxSpeed then
			if controlMaxSpeed:IsA("IntValue") or controlMaxSpeed:IsA("NumberValue") then
				controlMaxSpeed.Value = TARGET_SPEED
			elseif controlMaxSpeed:IsA("Configuration") or controlMaxSpeed:IsA("Folder") then
				controlMaxSpeed:SetAttribute("Value", TARGET_SPEED)
			end
		end
	end

	local speedOk = (speedObj and speedObj:IsA("IntValue") and speedObj.Value == TARGET_SPEED) or (speedObj == nil)
	local attrOk = (boat:GetAttribute("MaxSpeed") == TARGET_SPEED) or (seat:GetAttribute("MaxSpeed") == TARGET_SPEED)

	local controlOk = true
	if controlObj then
		local controlMaxSpeed = controlObj:FindFirstChild("MaxSpeed", true)
		if controlMaxSpeed and (controlMaxSpeed:IsA("IntValue") or controlMaxSpeed:IsA("NumberValue")) then
			controlOk = (controlMaxSpeed.Value == TARGET_SPEED)
		elseif controlObj:GetAttribute("MaxSpeed") ~= nil then
			controlOk = (controlObj:GetAttribute("MaxSpeed") == TARGET_SPEED)
		end
	end

	return speedOk and attrOk and controlOk
end

-- الضغط على الأزرار الأربعة بالترتيب
local function triggerTargetGuiButtons()
	for _, btnName in ipairs(targetButtonNames) do
		if not isActive then
			return
		end
		clickGuiButtonByName(btnName)
		task.wait(0.08)
	end
end

-- إطفاء كل شيء عند الضغط مرة ثانية
local function turnOffAll()
	isActive = false
	stopCurrentProcess()

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Sit then
		humanoid.Sit = false
		local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if rootPart then
			rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 3, -4)
		end
	end

	currentBoat = nil
end

-- تشغيل النظام عند الضغط لأول مرة
local function turnOnAll()
	local boat = findPlayerBoat()
	if not boat then
		showErrorMessage("لا يوجد قارب لك اشتري قارب")
		isActive = false
		return
	end

	local seat = findVehicleSeat(boat)
	if not seat then
		showErrorMessage("لا يوجد قارب لك اشتري قارب")
		isActive = false
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and (character:FindFirstChild("HumanoidRootPart") :: BasePart?)

	if not character or not humanoid or not rootPart then
		isActive = false
		return
	end

	isActive = true
	currentBoat = boat

	local aboveSeatPos = (seat.CFrame * CFrame.new(0, 2.5, 0)).Position
	customTweenToCFrame(rootPart, aboveSeatPos, TWEEN_DURATION, humanoid, seat, function()
		if not isActive then
			return
		end

		local timeout = os.clock() + 1.5
		while isActive and seat.Occupant ~= humanoid and os.clock() < timeout do
			task.wait(0.05)
		end

		if not isActive or seat.Occupant ~= humanoid then
			return
		end

		if setAndVerifySpeeds(boat, seat) then
			triggerTargetGuiButtons()
		end
	end)
end

-- معالجة ترسبن موديل MirageIsland داخل workspace.Map
local function handleMirageIsland(model: Model)
	if not model:IsA("Model") or model.Name ~= "MirageIsland" then
		return
	end
	if handledMirages[model] then
		return
	end
	handledMirages[model] = true

	local waitUntil = os.clock() + 2
	while model.Parent and #model:GetDescendants() == 0 and os.clock() < waitUntil do
		task.wait(0.05)
	end
	if not model.Parent then
		return
	end

	-- 1) الضغط على AnchorBtn تلقائياً
	clickGuiButtonByName("AnchorBtn")

	-- 2) حساب أعلى نقطة في MirageIsland
	local highestTargetPos = getHighestPointInModel(model)
	if not highestTargetPos then
		return
	end

	local character = player.Character
	local rootPart = character and (character:FindFirstChild("HumanoidRootPart") :: BasePart?)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if not rootPart then
		return
	end

	local movePart: BasePart = rootPart
	if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("BasePart") then
		local seatPart = humanoid.SeatPart
		if currentBoat and seatPart:IsDescendantOf(currentBoat) and currentBoat.PrimaryPart then
			movePart = currentBoat.PrimaryPart
		elseif currentBoat and seatPart:IsDescendantOf(currentBoat) then
			movePart = seatPart
		end
	end

	-- 3) تنفيذ Tween مخصص لأعلى نقطة ثم فك التوين تلقائياً
	customTweenToCFrame(movePart, highestTargetPos, MIRAGE_TWEEN_DURATION, nil, nil, function()
		stopCurrentProcess()
	end)
end

-- رصد أي MirageIsland يترسبن داخل workspace.Map
mirageConnection = mapFolder.DescendantAdded:Connect(function(descendant: Instance)
	if descendant:IsA("Model") and descendant.Name == "MirageIsland" then
		handleMirageIsland(descendant)
	end
end)

-- فحص إذا كان MirageIsland موجوداً مسبقاً داخل workspace.Map
for _, desc in ipairs(mapFolder:GetDescendants()) do
	if desc:IsA("Model") and desc.Name == "MirageIsland" then
		task.spawn(handleMirageIsland, desc)
	end
end

toggleButton.MouseButton1Click:Connect(function()
	if isActive then
		turnOffAll()
	else
		turnOnAll()
	end
end)
